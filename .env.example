# ── Database ──
# Local (docker compose or `yarn db:local`): port 5433
DATABASE_URL=postgresql://erp:erp@localhost:5433/erp?schema=public
DIRECT_URL=postgresql://erp:erp@localhost:5433/erp?schema=public
# Production (Neon):
# DATABASE_URL = pooled  host  + ?sslmode=require&pgbouncer=true&connection_limit=5
# DIRECT_URL   = unpooled host  + ?sslmode=require  (Prisma migrations)

# ── Server ──
PORT=4000
NODE_ENV=development
# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ── Auth ──
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# ── File storage ──
# local = ./storage folder on disk, s3 = any S3 compatible store (Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=erp-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Seed ──
SEED_ADMIN_EMAIL=admin@erp.local
SEED_ADMIN_PASSWORD=Admin@12345

# ── Scheduled jobs ──
# In-process hourly scheduler (notifications, quotation expiry, cleanup, nightly backup)
SCHEDULER_ENABLED=true
# Enables POST /api/v1/system/jobs for an external cron (min 16 chars). Leave empty to disable.
CRON_SECRET=
BACKUP_RETENTION=14
